{
    "compilerOptions": {
      "target": "es2021",
      "module": "commonjs",
      "outDir": "dist",
      "rootDir": "src",
      "strict": true,
      "declaration": true,
      "esModuleInterop": true,
      "moduleResolution": "node",
      "resolveJsonModule": true,
      "typeRoots": ["./node_modules/@types", "./src/types"]
    },
    "include": ["app/**/*"],
    "exclude": ["node_modules", "dist"]
  }
  